<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@drawable/widget_background">
    <TextView
        android:id="@+id/widget_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/widget_title"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end" />
    <TextView
        android:id="@+id/widget_status"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:text="@string/widget_ready"
        android:textColor="#D1D5DB"
        android:textSize="12sp"
        android:maxLines="2"
        android:ellipsize="end" />
    <TextView
        android:id="@+id/widget_wake"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center"
        android:background="@drawable/widget_button_background"
        android:text="@string/widget_wake"
        android:textColor="#102017"
        android:textStyle="bold"
        android:textSize="16sp" />
    <TextView
        android:id="@+id/widget_configure"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center"
        android:text="@string/widget_configure"
        android:textColor="#D1D5DB"
        android:textSize="12sp" />
</LinearLayout>
